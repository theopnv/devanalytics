{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2023"],
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "core/**/*.ts", "metrics/**/*.ts", "action/src/**/*.ts", "scripts/**/*.mts", "scripts/**/*.test.ts", "test/**/*.ts", "eslint.config.ts", "vitest.config.ts"]
}
