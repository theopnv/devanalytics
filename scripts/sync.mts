import { copyFile, mkdir, readdir, rm, writeFile } from 'node:fs/promises';
import path from 'node:path';

const METRIC_FILES = ['metric.ts', 'store.ts', 'collect.ts'] as const;
const NAME_PATTERN = /^[a-z][a-z0-9]*$/;
const HEADER = '// Generated by `npm run sync`. Do not edit.\n';

async function listNames(folder: string, keep: (entry: { name: string; isDirectory(): boolean }) => boolean): Promise<string[]> {
  const entries = await readdir(folder, { withFileTypes: true }).catch((error: NodeJS.ErrnoException) => {
    if (error.code === 'ENOENT') {
      return [];
    }
    throw error;
  });
  return entries.filter(keep).map((entry) => entry.name).sort();
}

async function metricNames(root: string): Promise<string[]> {
  const names = await listNames(path.join(root, 'metrics'), (entry) => entry.isDirectory());
  for (const name of names) {
    if (!NAME_PATTERN.test(name)) {
      throw new Error(`metrics/${name}: the folder name must use lowercase letters and digits only.`);
    }
    const files = await listNames(path.join(root, 'metrics', name), (entry) => !entry.isDirectory());
    const missing = METRIC_FILES.filter((file) => !files.includes(file));
    if (missing.length > 0) {
      throw new Error(`metrics/${name}: missing ${missing.join(', ')}.`);
    }
  }
  return names;
}

function workerRegistry(names: string[]): string {
  const imports = names.flatMap((name) => [
    `import { metric as ${name}Metric } from '../../metrics/${name}/metric.ts';`,
    `import { store as ${name}Store } from '../../metrics/${name}/store.ts';`,
  ]);
  const entries = names.map((name) => `  { metric: ${name}Metric, store: ${name}Store },\n`);
  return [
    HEADER,
    `import type { WorkerEntry } from '../../core/contract.ts';\n`,
    imports.length > 0 ? `${imports.join('\n')}\n` : '',
    `export const workerRegistry: readonly WorkerEntry[] = [\n${entries.join('')}];\n`,
  ].filter(Boolean).join('\n');
}

function collectorRegistry(names: string[]): string {
  const imports = names.flatMap((name) => [
    `import { metric as ${name}Metric } from '../../../metrics/${name}/metric.ts';`,
    `import { collector as ${name}Collector } from '../../../metrics/${name}/collect.ts';`,
  ]);
  const entries = names.map((name) => `  { metric: ${name}Metric, collector: ${name}Collector },\n`);
  return [
    HEADER,
    `import type { CollectorEntry } from '../../../core/contract.ts';\n`,
    imports.length > 0 ? `${imports.join('\n')}\n` : '',
    `export const collectorRegistry: readonly CollectorEntry[] = [\n${entries.join('')}];\n`,
  ].filter(Boolean).join('\n');
}

async function writeRegistry(file: string, content: string): Promise<void> {
  await mkdir(path.dirname(file), { recursive: true });
  await writeFile(file, content);
}

const isSql = (entry: { name: string; isDirectory(): boolean }): boolean => !entry.isDirectory() && entry.name.endsWith('.sql');

async function writeMigrations(root: string, names: string[]): Promise<void> {
  const target = path.join(root, 'migrations');
  await mkdir(target, { recursive: true });
  for (const stale of await listNames(target, isSql)) {
    await rm(path.join(target, stale));
  }
  const coreFolder = path.join(root, 'core', 'migrations');
  for (const file of await listNames(coreFolder, isSql)) {
    await copyFile(path.join(coreFolder, file), path.join(target, file));
  }
  for (const name of names) {
    const folder = path.join(root, 'metrics', name, 'migrations');
    for (const file of await listNames(folder, isSql)) {
      await copyFile(path.join(folder, file), path.join(target, `${name}__${file}`));
    }
  }
}

/** Writes the two registries and `migrations/` for the metrics in `metrics/`. Returns the metric names. */
export async function sync(root: string): Promise<string[]> {
  const names = await metricNames(root);
  await writeRegistry(path.join(root, 'src', 'generated', 'worker-registry.ts'), workerRegistry(names));
  await writeRegistry(path.join(root, 'action', 'src', 'generated', 'collector-registry.ts'), collectorRegistry(names));
  await writeMigrations(root, names);
  return names;
}

if (import.meta.main) {
  const names = await sync(path.resolve(import.meta.dirname, '..'));
  process.stdout.write(`sync: ${names.length} metric(s): ${names.join(', ') || 'none'}\n`);
}
