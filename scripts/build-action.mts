import { mkdir, readFile, writeFile } from 'node:fs/promises';
import path from 'node:path';
import { pathToFileURL } from 'node:url';
import { build } from 'esbuild';
import type { CollectorEntry } from '../core/contract.ts';

const CORE_INPUTS = ['metric', 'worker-url', 'token', 'working-directory'];
const BEGIN = '  # BEGIN METRIC INPUTS (generated by `npm run build:action`)';
const END = '  # END METRIC INPUTS';

function describeInput(metric: string, { description, default: fallback }: { description: string; default?: string }): string {
  return `${metric}: ${description}${fallback === undefined ? '' : ` Default: ${fallback}.`}`;
}

/** Two metrics can share an input name, such as `reports`. The default of each metric is applied in the code, so action.yml has none. */
export function renderMetricInputs(registry: readonly CollectorEntry[]): string {
  const descriptions = new Map<string, string[]>();
  for (const { metric, collector } of registry) {
    for (const input of collector.inputs) {
      if (CORE_INPUTS.includes(input.name)) {
        throw new Error(`metrics/${metric.name}: the input "${input.name}" is already an input of the Action.`);
      }
      descriptions.set(input.name, [...(descriptions.get(input.name) ?? []), describeInput(metric.name, input)]);
    }
  }
  return [...descriptions].map(([name, parts]) => `  ${name}:\n    description: ${JSON.stringify(parts.join(' '))}\n    required: false\n`).join('');
}

export function replaceMetricInputs(actionYml: string, inputs: string): string {
  const start = actionYml.indexOf(BEGIN);
  const end = actionYml.indexOf(END);
  if (start === -1 || end < start) {
    throw new Error('action/action.yml: the markers of the metric inputs are missing.');
  }
  return `${actionYml.slice(0, start + BEGIN.length)}\n${inputs}${actionYml.slice(end)}`;
}

/** Bundles the Action into `action/dist/` and writes the metric inputs into `action/action.yml`. Run `sync` first. */
export async function buildAction(root: string): Promise<void> {
  const registryFile = path.join(root, 'action', 'src', 'generated', 'collector-registry.ts');
  const { collectorRegistry } = await import(pathToFileURL(registryFile).href) as { collectorRegistry: readonly CollectorEntry[] };

  const dist = path.join(root, 'action', 'dist');
  await build({
    absWorkingDir: root,
    entryPoints: ['action/src/index.ts'],
    outfile: 'action/dist/index.js',
    bundle: true,
    platform: 'node',
    target: 'node24',
    // ESLint and TypeScript read __filename, which an ES module does not have.
    format: 'cjs',
    legalComments: 'none',
    logLevel: 'warning',
  });
  // The root package.json says "type": "module", and the bundle is CommonJS.
  await mkdir(dist, { recursive: true });
  await writeFile(path.join(dist, 'package.json'), '{ "type": "commonjs" }\n');

  const actionYml = path.join(root, 'action', 'action.yml');
  await writeFile(actionYml, replaceMetricInputs(await readFile(actionYml, 'utf8'), renderMetricInputs(collectorRegistry)));
}

if (import.meta.main) {
  await buildAction(path.resolve(import.meta.dirname, '..'));
  process.stdout.write('build:action: wrote action/dist/index.js\n');
}
