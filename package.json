{
  "name": "devanalytics",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync": "node scripts/sync.mts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build:action": "node scripts/build-action.mts",
    "smoke": "node scripts/smoke.mts",
    "backfill": "node scripts/backfill.mts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "npm run sync && wrangler d1 migrations apply DB --local",
    "migrate:remote": "npm run sync && wrangler d1 migrations apply DB --remote",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "fast-xml-parser": "^5.12.1",
    "istanbul-lib-coverage": "^3.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  }
}
